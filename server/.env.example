# Copy to server/.env for local runs (`npm run dev`). On Railway, set these as service variables.
# Never commit real values. The real ones live in D:\Tools\my-vault\vault.json.

# Stripe secret or restricted key. Test keys (sk_test_ / rk_test_) until launch.
# A restricted key needs: Checkout Sessions = Write. (Read is included.)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Endpoint: <PUBLIC_URL>/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Live keys refuse to start unless this is 1.
STRIPE_ALLOW_LIVE=0

# The hub. HUB_TOKEN is the hub's LAB_TOKEN (vault: EE_AUTO_LAB_TOKEN).
HUB_URL=https://ee-auto.up.railway.app
HUB_TOKEN=

# Company-diver reports (docs/report-display.md). The database is read only: use a read-only login.
# Empty = DATABASE_URL is used instead.
REPORT_DB_URL=
# The report factory's public address, for the free preview /p/<id>. Ask the owner. Not the old ee-auto hub.
# Empty = https://<RAILWAY_SERVICE_COMPANY_DIVER_URL> on Railway.
REPORT_HUB_URL=
# Operator token of that factory, used to start a paid full report (POST /api/v21/deeper). Empty = HUB_TOKEN.
REPORT_HUB_TOKEN=

# Free preview requests (dashboard). Each new request is emailed to PREVIEW_ALERT_EMAIL. The report factory (or you)
# marks one ready with: POST <PUBLIC_URL>/api/previews/<id>/ready  Authorization: Bearer <PREVIEW_ADMIN_TOKEN>
# {"report_id":"<uuid>"}. That emails the buyer their preview link. No token = that endpoint is off.
# 1 = a new free-preview request starts its research on the report factory by itself (needs REPORT_HUB_TOKEN; real LLM cost).
PREVIEW_AUTO_START=0
# The industry told to the factory (the request form does not ask). Must be a name the factory knows, or it researches without an industry list.
PREVIEW_INDUSTRY=General business
PREVIEW_ALERT_EMAIL=
PREVIEW_ADMIN_TOKEN=
# The office key. Every team page (/myoffice/*) opens with it at /myoffice/login. Changing it signs every
# office browser out. Empty = the office cannot be opened. Keep it long and random; never commit it.
OFFICE_KEY=

# Email (Mailjet). Vault: MAILJET_API_KEY and MAILJET_SECRET_KEY. Domain mirrormirror.cloud, sender admin@mirrormirror.cloud.
# Without keys the server still runs; every email is logged as failed in the database.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=admin@mirrormirror.cloud
MAIL_FROM_NAME=MirrorMirror
# 1 = print each email (including its sign-in link) to the server log instead of sending it. For local runs.
MAIL_DRY_RUN=0

# Where the site's database lives (accounts, orders, mail log). On Railway: a volume mount path, e.g. /data.
DATA_DIR=

# Shown on invoices as the seller. Fill in once the company behind MirrorMirror is decided.
INVOICE_SELLER_NAME=MirrorMirror
INVOICE_SELLER_ADDRESS=
INVOICE_NOTE=

# Price of the report bundle, in cents: USD 89 (2 full reports + 1 Social Media Ads report), owner 2026-11-13.
PRICE_CENTS=8900
PRICE_CURRENCY=usd

# The site's public address, used for Stripe's return links. Empty = taken from the request.
PUBLIC_URL=

# Visitor analytics (/myoffice/visitors, docs/analytics.md). Times on that page are shown in this time zone.
ANALYTICS_TZ=Asia/Kuala_Lumpur
# GeoIP file for visitor locations. Empty = server/geo/dbip-city.mmdb (the Docker build downloads it; locally run
# `node server/geo-fetch.js`). No file = locations are empty, everything else works.
GEOIP_DB=
# Ops tools (docs/ops.md): read logs, the site database and the report database over HTTP.
# Long random token. Empty = the ops routes answer 503. Keep it in the vault (MIRRORMIRROR_OPS_TOKEN), never in git.
OPS_TOKEN=
PORT=8080
